# Copy to .env and fill in. .env is git-ignored.

# Which AI provider to use: OPENAI or GEMINI
AI_PROVIDER=OPENAI

# Required for AI_PROVIDER=OPENAI
OPENAI_API_KEY=sk-your-openai-key-here

# Required for AI_PROVIDER=GEMINI
GOOGLE_API_KEY=your-google-api-key-here

# Verbose AI call logging (true/false)
DEBUG_MODE=false

# Optional model overrides (defaults live in config.py)
# OPENAI_MODEL=gpt-5.4-mini
# GEMINI_MODEL=gemini-3-flash
